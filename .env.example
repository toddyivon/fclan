# Public (shipped to browser) — use pk_ / anon keys only
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose
SUPABASE_SERVICE_ROLE_KEY=
# Prefer the session pooler URL (db.<ref>.supabase.co is IPv6-only on new projects)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_AI_PREMIUM=price_xxx
# Optional annual prices (enable yearly billing in checkout when set)
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_AI_PREMIUM_ANNUAL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# AI
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional: point at a mock for offline testing (scripts/mock-openrouter.mjs)
OPENROUTER_BASE_URL=

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional
SENTRY_DSN=
